# Database Configuration (Supabase/PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/probfair

# Security
JWT_SECRET=your_super_secret_jwt_key_change_this
# Generate one with: openssl rand -base64 32

# Categories needs no API keys or external judging service.

# Client Config (if needed)
VITE_API_URL=http://localhost:3000

# In-page remote desktop relay. Disabled until all three required values are valid.
# Generate private settings on the HOME PC using the downloaded configure.mjs.
VM_PUBLIC_ORIGIN=https://quota.wamomath.org
VM_ACCESS_PASSWORD=
VM_AGENT_TOKEN=
VM_COMPUTER_NAME=Home computer
VM_ENABLED=true
